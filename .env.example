# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:  copy .env.example .env
# ---------------------------------------------------------------------------

APP_NAME="InnoVisionPH Hackathon API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

# Default: SQLite file `innovision.db` in the project root (zero setup).
# DATABASE_URL=sqlite:///./innovision.db
# PostgreSQL example (pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/innovision
DATABASE_ECHO=false

# JSON list of allowed origins
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

LOG_LEVEL=INFO
